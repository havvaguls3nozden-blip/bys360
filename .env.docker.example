# Example Docker environment configuration.
# Copy this file to a local untracked environment file (e.g. .env.docker.local,
# which docker-compose.yml already reads via `env_file:`) and replace every
# placeholder below with your own values.
# Never commit real credentials or production secrets.

# --- Application ---
APP_ENV=development
SECRET_KEY=replace-with-a-strong-random-value
LOG_LEVEL=INFO
STRICT_ENV_VALIDATION=true

# --- Database (matches the postgres service in docker-compose.yml) ---
POSTGRES_DB=bys_db
POSTGRES_USER=bys_user
POSTGRES_PASSWORD=replace-with-a-strong-random-value
DATABASE_URL=postgresql://user:password@db:5432/bys360

# --- Cache (matches the redis service in docker-compose.yml) ---
REDIS_URL=redis://redis:6379/0

# --- Networking ---
PORT=8000
BYS360_HOST_PORT=8000

# --- Container runtime behavior (docker/entrypoint.sh) ---
BYS360_DEPLOYMENT_MODE=docker
BYS360_RUN_MIGRATIONS_ON_STARTUP=false
BYS360_COMPILE_ON_STARTUP=false
FLASK_APP=wsgi.py

# --- Gunicorn (docker/gunicorn.conf.py) ---
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120

# --- Optional integrations (leave empty to disable) ---
SENTRY_DSN=
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=
MAIL_DEFAULT_SENDER=
AI_ENABLED=false
AI_API_KEY=

# For the full catalog of optional application-level settings (feature
# flags, session/cookie hardening, file-center paths, etc.), see the
# repo-root .env.example -- this file only covers what a Docker/compose
# deployment specifically needs to start.
