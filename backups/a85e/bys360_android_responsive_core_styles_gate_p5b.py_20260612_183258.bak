# -*- coding: utf-8 -*-
"""BYS360 P5B Android Responsive Core Styles Gate.

Adds a central Android/web responsive hardening stylesheet and verifies that it is
linked from the base template. The change is intentionally generic and safe: it
uses global layout safeguards, table/form overflow handling, touch target sizing,
and small/landscape Android breakpoints without touching business data.
"""
from __future__ import annotations

import argparse
import json
import os
import py_compile
import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Sequence

PACKAGE = "BYS360_CLAUDE_SCORE_UPLIFT_P5B_ANDROID_RESPONSIVE_CORE_STYLES_GATE"
REPORT_REL = Path("reports/architecture/BYS360_ANDROID_RESPONSIVE_CORE_STYLES_GATE_P5B_REPORT.json")
P5A_REPORT_REL = Path("reports/architecture/BYS360_ANDROID_RESPONSIVE_BASELINE_GATE_P5A_REPORT.json")
SECRET_REPORT_REL = Path("reports/quality/BYS360_SECRET_REPO_GATE_V1_REPORT.json")
EXPECTED_CONTRACT_ROUTE_COUNT = 24
CSS_REL = Path("app/static/css/bys360_android_responsive_core_p5b.css")
BASE_TEMPLATE_REL = Path("app/templates/base.html")
LINK_MARKER = "bys360_android_responsive_core_p5b.css"

ROUTE_DECORATOR_RE = re.compile(r"@\s*mobile_api_bp\s*\.\s*(get|post|put|patch|delete)\s*\(", re.I)

CORE_CSS = r'''/* BYS360 P5B Android Responsive Core Styles
   Central responsive safety layer for Android Web/PWA surfaces.
   This file is deliberately generic and does not alter data or permissions. */

:root {
  --bys360-android-safe-x: max(12px, env(safe-area-inset-left));
  --bys360-android-safe-y: max(10px, env(safe-area-inset-top));
  --bys360-android-page-gap: clamp(10px, 3vw, 24px);
  --bys360-android-card-radius: clamp(12px, 2vw, 18px);
  --bys360-android-touch-target: 44px;
}

html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
  max-width: 100%;
}

body {
  max-width: 100%;
  overflow-x: hidden;
}

*, *::before, *::after {
  box-sizing: border-box;
}

img, svg, video, canvas, iframe {
  max-width: 100%;
}

img, video, canvas {
  height: auto;
}

table {
  width: 100%;
}

.table-responsive,
.responsive-table,
.bys360-responsive-table,
.table-wrapper,
.data-table-wrapper,
.report-table-wrapper,
.kurumsal-table-wrapper,
.performance-table-wrapper,
.overflow-x-auto {
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.card,
.panel,
.box,
.widget,
.dashboard-card,
.kpi-card,
.performance-card,
.bys360-card,
.form-card,
.stat-card {
  min-width: 0;
  overflow-wrap: anywhere;
}

button,
.btn,
.button,
input,
select,
textarea,
a.btn,
[role="button"] {
  min-height: var(--bys360-android-touch-target);
}

input,
select,
textarea {
  max-width: 100%;
}

pre,
code,
.log-output,
.json-output {
  max-width: 100%;
  overflow-x: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.modal,
.modal-dialog,
.dialog,
.drawer,
.offcanvas,
.sidebar,
.mobile-sidebar,
.side-nav {
  max-width: 100vw;
}

@media (max-width: 900px) {
  .container,
  .container-fluid,
  .content,
  .content-wrapper,
  .main-content,
  .page-content,
  main,
  .bys360-page,
  .bys360-shell,
  .dashboard-shell,
  .performance-shell {
    width: 100%;
    max-width: 100%;
    padding-left: var(--bys360-android-page-gap);
    padding-right: var(--bys360-android-page-gap);
  }

  .row,
  .grid,
  .dashboard-grid,
  .kpi-grid,
  .card-grid,
  .stats-grid,
  .performance-grid,
  .form-grid,
  .two-column,
  .three-column,
  .admin-grid,
  .settings-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) !important;
    gap: var(--bys360-android-page-gap);
  }

  .d-flex,
  .toolbar,
  .page-toolbar,
  .action-bar,
  .filter-bar,
  .button-row,
  .form-actions,
  .header-actions {
    flex-wrap: wrap;
    gap: 10px;
  }

  .sidebar,
  .mobile-sidebar,
  .offcanvas,
  .side-nav {
    width: min(92vw, 380px);
  }

  .modal-dialog,
  .dialog {
    margin: 12px;
    max-width: calc(100vw - 24px);
  }
}

@media (max-width: 600px) {
  h1, .h1, .page-title {
    font-size: clamp(1.35rem, 6.5vw, 1.9rem);
    line-height: 1.18;
  }

  h2, .h2, .section-title {
    font-size: clamp(1.15rem, 5.4vw, 1.55rem);
    line-height: 1.22;
  }

  .card,
  .panel,
  .box,
  .widget,
  .dashboard-card,
  .performance-card,
  .form-card {
    border-radius: var(--bys360-android-card-radius);
    padding: clamp(12px, 4vw, 18px);
  }

  .table,
  table {
    font-size: 0.92rem;
  }

  .btn,
  button,
  a.btn,
  [role="button"] {
    width: auto;
    max-width: 100%;
    white-space: normal;
  }

  .btn-block-mobile,
  .mobile-full-width,
  .form-actions .btn,
  .button-row .btn {
    width: 100%;
  }
}

@media (max-width: 420px) {
  :root {
    --bys360-android-page-gap: 12px;
  }

  .container,
  .container-fluid,
  .content,
  .content-wrapper,
  .main-content,
  .page-content,
  main {
    padding-left: 12px;
    padding-right: 12px;
  }

  .hide-on-small-android {
    display: none !important;
  }

  .table-responsive,
  .responsive-table,
  .bys360-responsive-table,
  .table-wrapper,
  .data-table-wrapper {
    border-radius: 12px;
  }
}

@media (orientation: landscape) and (max-height: 500px) {
  .mobile-sticky-header,
  .sticky-top,
  .page-header,
  .navbar {
    position: static !important;
  }

  .modal-dialog,
  .dialog {
    margin-top: 8px;
    margin-bottom: 8px;
  }
}

@media (min-width: 600px) and (max-width: 1024px) {
  .dashboard-grid,
  .kpi-grid,
  .stats-grid,
  .card-grid,
  .performance-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
'''

REQUIRED_CSS_MARKERS = [
    "@media (max-width: 900px)",
    "@media (max-width: 600px)",
    "@media (max-width: 420px)",
    "@media (orientation: landscape)",
    "@media (min-width: 600px)",
    "overflow-x: auto",
    "-webkit-overflow-scrolling: touch",
    "min-height: var(--bys360-android-touch-target)",
    "clamp(",
    "env(safe-area-inset-left)",
]


def _read_json(path: Path) -> Dict[str, Any]:
    if not path.exists():
        return {"_exists": False, "_path": str(path)}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except UnicodeDecodeError:
        data = json.loads(path.read_text(encoding="utf-8-sig"))
    except Exception as exc:
        return {"_exists": True, "_path": str(path), "_read_error": str(exc)}
    if isinstance(data, dict):
        data.setdefault("_exists", True)
        data.setdefault("_path", str(path))
        return data
    return {"_exists": True, "_path": str(path), "_read_error": "json root is not object"}


def _line_count(path: Path) -> int:
    if not path.exists():
        return 0
    return len(path.read_text(encoding="utf-8", errors="ignore").splitlines())


def _count_route_decorators(path: Path) -> int:
    if not path.exists():
        return 0
    return len(ROUTE_DECORATOR_RE.findall(path.read_text(encoding="utf-8", errors="ignore")))


def _mobile_inventory(root: Path) -> Dict[str, Any]:
    mobile_dir = root / "app" / "api" / "mobile"
    routes_py = mobile_dir / "routes.py"
    domains_dir = mobile_dir / "domains"
    files: List[Path] = []
    if routes_py.exists():
        files.append(routes_py)
    if domains_dir.exists():
        files.extend(sorted(domains_dir.glob("*.py")))
    total = 0
    domain_inventory: List[Dict[str, Any]] = []
    for file_path in files:
        route_count = _count_route_decorators(file_path)
        total += route_count
        domain_inventory.append({
            "path": str(file_path.relative_to(root)).replace("\\", "/"),
            "exists": file_path.exists(),
            "route_count": route_count,
            "lines": _line_count(file_path),
        })
    routes_py_lines = _line_count(routes_py)
    return {
        "routes_py_lines": routes_py_lines,
        "routes_py_under_300_lines": routes_py_lines <= 300,
        "routes_py_route_count": _count_route_decorators(routes_py),
        "domains_dir_exists": domains_dir.exists(),
        "domain_inventory": domain_inventory,
        "total_mobile_route_decorator_count": total,
        "expected_contract_route_count": EXPECTED_CONTRACT_ROUTE_COUNT,
        "route_contract_count_expected": total == EXPECTED_CONTRACT_ROUTE_COUNT,
    }


def _ensure_core_css(root: Path) -> Dict[str, Any]:
    path = root / CSS_REL
    path.parent.mkdir(parents=True, exist_ok=True)
    old = path.read_text(encoding="utf-8", errors="ignore") if path.exists() else ""
    changed = old != CORE_CSS
    if changed:
        path.write_text(CORE_CSS, encoding="utf-8")
    text = path.read_text(encoding="utf-8", errors="ignore")
    missing = [marker for marker in REQUIRED_CSS_MARKERS if marker not in text]
    media_count = text.count("@media")
    return {
        "path": str(CSS_REL).replace("\\", "/"),
        "exists": path.exists(),
        "changed": changed,
        "line_count": len(text.splitlines()),
        "byte_count": len(text.encode("utf-8")),
        "required_marker_count": len(REQUIRED_CSS_MARKERS) - len(missing),
        "required_marker_total": len(REQUIRED_CSS_MARKERS),
        "missing_required_markers": missing,
        "media_query_count": media_count,
        "ok": path.exists() and not missing and media_count >= 5,
    }


def _ensure_base_link(root: Path) -> Dict[str, Any]:
    path = root / BASE_TEMPLATE_REL
    if not path.exists():
        return {"path": str(BASE_TEMPLATE_REL).replace("\\", "/"), "exists": False, "changed": False, "linked": False, "ok": False, "error": "base.html missing"}
    text = path.read_text(encoding="utf-8", errors="ignore")
    if LINK_MARKER in text:
        return {"path": str(BASE_TEMPLATE_REL).replace("\\", "/"), "exists": True, "changed": False, "linked": True, "ok": True, "error": ""}
    link_line = '    <link rel="stylesheet" href="{{ url_for(\'static\', filename=\'css/bys360_android_responsive_core_p5b.css\') }}">\n'
    insert_patterns = ["</head>", "{% block head_extra %}", "{% block extra_head %}"]
    changed = False
    for pattern in insert_patterns:
        idx = text.lower().find(pattern.lower())
        if idx >= 0:
            text = text[:idx] + link_line + text[idx:]
            changed = True
            break
    if not changed:
        text = text.rstrip() + "\n" + link_line
        changed = True
    path.write_text(text, encoding="utf-8")
    text2 = path.read_text(encoding="utf-8", errors="ignore")
    return {"path": str(BASE_TEMPLATE_REL).replace("\\", "/"), "exists": True, "changed": changed, "linked": LINK_MARKER in text2, "ok": LINK_MARKER in text2, "error": ""}


def _surface_priority_from_p5a(root: Path) -> Dict[str, Any]:
    p5a = _read_json(root / P5A_REPORT_REL)
    scan = p5a.get("responsive_surface_scan", {}) if isinstance(p5a, dict) else {}
    sample = scan.get("sample_files", []) if isinstance(scan, dict) else []
    no_marker = []
    for item in sample:
        if not isinstance(item, dict):
            continue
        hits = item.get("responsive_marker_hits") or []
        path = item.get("path", "")
        if not hits and path.endswith(".html"):
            no_marker.append(path)
    priority_keywords = ["dashboard", "evaluation", "performance", "hr_", "admin", "feedback", "communication", "home"]
    priority = [path for path in no_marker if any(key in path.lower() for key in priority_keywords)]
    return {
        "source_report_exists": bool(p5a.get("_exists")),
        "p5a_ok": bool(p5a.get("ok")),
        "candidate_no_marker_count": len(no_marker),
        "priority_no_marker_count": len(priority),
        "priority_no_marker_sample": priority[:40],
        "note": "P5B covers these surfaces with a central stylesheet; P5C can patch individual high-risk templates if visual UAT still finds issues.",
    }


def _compile_files(files: Sequence[Path]) -> List[Dict[str, Any]]:
    results: List[Dict[str, Any]] = []
    for file_path in files:
        if not file_path.exists():
            results.append({"file": str(file_path), "ok": False, "error": "missing"})
            continue
        try:
            py_compile.compile(str(file_path), doraise=True)
            results.append({"file": str(file_path), "ok": True, "error": ""})
        except Exception as exc:
            results.append({"file": str(file_path), "ok": False, "error": str(exc)})
    return results


def _run_cmd(cmd: Sequence[str], cwd: Path) -> Dict[str, Any]:
    try:
        completed = subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=120)
        return {
            "returncode": completed.returncode,
            "stdout_tail": completed.stdout[-2000:],
            "stderr_tail": completed.stderr[-2000:],
            "ok": completed.returncode == 0,
            "cmd": list(cmd),
        }
    except Exception as exc:
        return {"returncode": -1, "stdout_tail": "", "stderr_tail": str(exc), "ok": False, "cmd": list(cmd)}


def _app_factory(root: Path) -> Dict[str, Any]:
    code = "from app import create_app; app=create_app(); print('APP_FACTORY_OK')"
    return _run_cmd([sys.executable, "-c", code], root)


def _secret_gate(root: Path) -> Dict[str, Any]:
    script = root / "scripts" / "quality" / "bys360_secret_repo_gate.py"
    if not script.exists():
        return {"ok": False, "returncode": -1, "stdout_tail": "", "stderr_tail": "secret gate script missing", "cmd": [str(script)]}
    result = _run_cmd([sys.executable, str(script), "--root", str(root)], root)
    parsed: Dict[str, Any] = {}
    try:
        parsed = json.loads(result.get("stdout_tail", "").strip())
    except Exception:
        report = _read_json(root / SECRET_REPORT_REL)
        if report.get("_exists"):
            parsed = report
    result["parsed"] = parsed
    result["ok"] = bool(result.get("ok")) and bool(parsed.get("ok", result.get("ok")))
    return result


def _pytest_gate(root: Path) -> Dict[str, Any]:
    test = root / "tests" / "architecture" / "test_android_responsive_core_styles_p5b.py"
    if not test.exists():
        return {"ok": False, "returncode": -1, "stdout_tail": "", "stderr_tail": "test missing", "cmd": [str(test)]}
    return _run_cmd([sys.executable, "-m", "pytest", str(test.relative_to(root)), "-q"], root)


def run(root: Path, compile_all: bool, app_factory: bool, secret_gate: bool, pytest_gate: bool) -> Dict[str, Any]:
    root = root.resolve()
    p5a = _read_json(root / P5A_REPORT_REL)
    inventory = _mobile_inventory(root)
    css_result = _ensure_core_css(root)
    base_link = _ensure_base_link(root)
    surface_priority = _surface_priority_from_p5a(root)

    compile_results: List[Dict[str, Any]] = []
    if compile_all:
        compile_results = _compile_files([
            root / "scripts" / "quality" / "bys360_android_responsive_core_styles_gate_p5b.py",
            root / "tests" / "architecture" / "test_android_responsive_core_styles_p5b.py",
            root / "tests" / "architecture" / "conftest.py",
        ])
    compile_ok = all(item.get("ok") for item in compile_results) if compile_all else True

    app_factory_result = _app_factory(root) if app_factory else {"ok": True, "skipped": True}
    secret_result = _secret_gate(root) if secret_gate else {"ok": True, "skipped": True, "parsed": {}}
    pytest_result = _pytest_gate(root) if pytest_gate else {"ok": True, "skipped": True}
    secret_finding_count = int(((secret_result.get("parsed") or {}).get("finding_count") or 0)) if isinstance(secret_result, dict) else 0

    p5a_ok = bool(p5a.get("ok")) and bool(p5a.get("android_responsive_baseline_gate_ok"))
    direct_contract_ok = bool(inventory.get("route_contract_count_expected")) and bool(inventory.get("routes_py_under_300_lines"))
    android_core_style_ok = bool(css_result.get("ok")) and bool(base_link.get("ok"))
    responsive_hardening_ok = android_core_style_ok and p5a_ok and direct_contract_ok

    report: Dict[str, Any] = {
        "ok": False,
        "package": PACKAGE,
        "generated_at": datetime.now().replace(microsecond=0).isoformat(),
        "root": str(root),
        "android_responsive_core_styles_gate_ok": responsive_hardening_ok,
        "responsive_hardening_ok": responsive_hardening_ok,
        "p5a_baseline_report_ok": p5a_ok,
        "mobile_release_evidence_report_ok": bool(p5a.get("mobile_release_evidence_report_ok") or p5a.get("p4_ok")),
        "android_core_css_ok": bool(css_result.get("ok")),
        "base_template_link_ok": bool(base_link.get("ok")),
        "responsive_marker_total_after_p5a": int(p5a.get("responsive_marker_total") or 0),
        "core_css_required_marker_count": int(css_result.get("required_marker_count") or 0),
        "core_css_required_marker_total": int(css_result.get("required_marker_total") or 0),
        "core_css_media_query_count": int(css_result.get("media_query_count") or 0),
        "routes_py_lines": inventory.get("routes_py_lines", 0),
        "routes_py_under_300_lines": inventory.get("routes_py_under_300_lines", False),
        "total_mobile_route_decorator_count": inventory.get("total_mobile_route_decorator_count", 0),
        "expected_contract_route_count": EXPECTED_CONTRACT_ROUTE_COUNT,
        "direct_contract_ok": direct_contract_ok,
        "compile_ok": compile_ok,
        "app_factory_ok": bool(app_factory_result.get("ok")),
        "secret_gate_ok": bool(secret_result.get("ok")),
        "secret_gate_finding_count": secret_finding_count,
        "pytest_ok": bool(pytest_result.get("ok")),
        "pytest_mode": "pytest_targeted_android_responsive_core_styles_p5b" if pytest_gate else "skipped",
        "inventory": inventory,
        "core_css": css_result,
        "base_template_link": base_link,
        "surface_priority": surface_priority,
        "compile_results": compile_results,
        "app_factory_smoke": app_factory_result,
        "secret_gate": secret_result,
        "pytest": pytest_result,
        "source_reports": {"p5a": str(root / P5A_REPORT_REL)},
        "ci_commands": [
            "python -m pip install -r requirements-dev.txt",
            "python -m pytest tests/architecture -q",
            "python scripts/quality/bys360_android_responsive_core_styles_gate_p5b.py --root . --compile-all --app-factory --secret-gate --pytest-gate",
        ],
        "report": str(root / REPORT_REL),
        "next_actions": [
            "P5B temizse Android/Web responsive merkezi CSS katmani base template uzerinden devreye alinmis kabul edilebilir.",
            "P5C'de P5A/P5B raporlarina gore en riskli tekil ekranlar icin hedefli template/table/form breakpoint duzeltmeleri yapilabilir.",
        ],
    }
    report["ok"] = bool(
        responsive_hardening_ok
        and compile_ok
        and app_factory_result.get("ok")
        and secret_result.get("ok")
        and secret_finding_count == 0
        and pytest_result.get("ok")
    )

    (root / REPORT_REL).parent.mkdir(parents=True, exist_ok=True)
    (root / REPORT_REL).write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
    return report


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", required=True)
    parser.add_argument("--compile-all", action="store_true")
    parser.add_argument("--app-factory", action="store_true")
    parser.add_argument("--secret-gate", action="store_true")
    parser.add_argument("--pytest-gate", action="store_true")
    args = parser.parse_args()
    report = run(Path(args.root), args.compile_all, args.app_factory, args.secret_gate, args.pytest_gate)
    print(json.dumps({
        "ok": report["ok"],
        "package": PACKAGE,
        "android_responsive_core_styles_gate_ok": report["android_responsive_core_styles_gate_ok"],
        "responsive_hardening_ok": report["responsive_hardening_ok"],
        "p5a_baseline_report_ok": report["p5a_baseline_report_ok"],
        "android_core_css_ok": report["android_core_css_ok"],
        "base_template_link_ok": report["base_template_link_ok"],
        "core_css_media_query_count": report["core_css_media_query_count"],
        "routes_py_lines": report["routes_py_lines"],
        "total_mobile_route_decorator_count": report["total_mobile_route_decorator_count"],
        "direct_contract_ok": report["direct_contract_ok"],
        "compile_ok": report["compile_ok"],
        "app_factory_ok": report["app_factory_ok"],
        "secret_gate_ok": report["secret_gate_ok"],
        "secret_gate_finding_count": report["secret_gate_finding_count"],
        "pytest_ok": report["pytest_ok"],
        "pytest_mode": report["pytest_mode"],
        "report": report["report"],
    }, ensure_ascii=False, indent=2))
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
